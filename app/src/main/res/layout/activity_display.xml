<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/layout_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/colorPrimary"
      android:padding="16dp"
      app:layout_constraintTop_toTopOf="parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Disconnected"
            android:textColor="#EEEEEE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="0 kbps | 0 fps"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:textStyle="bold" />
      </LinearLayout>

      <TextView
          android:id="@+id/tv_notification_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Notifications Status: Off"
          android:textColor="#EEEEEE"
          android:textSize="11sp" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>

  <com.google.android.material.tabs.TabLayout
      android:id="@+id/tab_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#1E1E1E"
      app:layout_constraintTop_toBottomOf="@id/layout_header"
      app:tabTextColor="#888888"
      app:tabSelectedTextColor="@color/white"
      app:tabIndicatorColor="@color/white">

    <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings" />

    <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preview" />

    <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log" />
  </com.google.android.material.tabs.TabLayout>

  <FrameLayout
      android:id="@+id/layout_container"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:layout_constraintTop_toBottomOf="@id/tab_layout"
      app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar">

    <!-- Settings Tab -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tab_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stream Target"
            android:textColor="@color/white" />

        <Spinner
            android:id="@+id/sp_target"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:entries="@array/stream_targets" />

        <EditText
            android:id="@+id/et_omnistream_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OmniStream host (IP or hostname)"
            android:textColor="@color/white"
            android:textColorHint="#666666"
            android:inputType="textUri"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_rtp_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom RTMP/SRT URL"
            android:textColor="@color/white"
            android:textColorHint="#666666"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <EditText
              android:id="@+id/et_stream_key"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="Stream Key"
              android:textColor="@color/white"
              android:textColorHint="#666666"
              android:inputType="textPassword"
              android:paddingEnd="48dp" />

          <ImageView
              android:id="@+id/b_show_password"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:layout_gravity="end|center_vertical"
              android:layout_marginEnd="8dp"
              android:src="@drawable/switch_icon" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolution"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/sp_resolution"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Source"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/sp_audio_source"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:entries="@array/audio_sources" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_tts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speak Chat Messages (TTS)"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_system_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Chat System Notifications"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_chat_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Twitch Channel Name"
            android:textColor="@color/white"
            android:textColorHint="#666666" />

        <LinearLayout
            android:id="@+id/layout_youtube_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

          <FrameLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

            <EditText
                android:id="@+id/et_youtube_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="YouTube API Key"
                android:textColor="@color/white"
                android:textColorHint="#666666"
                android:inputType="textPassword"
                android:paddingEnd="48dp" />

            <ImageView
                android:id="@+id/b_show_youtube_api"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/switch_icon" />
          </FrameLayout>

          <EditText
              android:id="@+id/et_youtube_video_id"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="YouTube Video ID"
              android:textColor="@color/white"
              android:textColorHint="#666666" />
        </LinearLayout>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Preview Tab -->
    <FrameLayout
        android:id="@+id/tab_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

      <SurfaceView
          android:id="@+id/surfaceView"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_gravity="center" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Preview will appear here when active"
          android:textColor="#888888"
          android:layout_gravity="center" />
    </FrameLayout>

    <!-- Log Tab -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tab_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

      <TextView
          android:id="@+id/tv_log"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="8dp"
          android:textColor="#00FF00"
          android:textSize="12sp"
          android:fontFamily="monospace"
          android:text="-- Log Started --\n" />
    </androidx.core.widget.NestedScrollView>
  </FrameLayout>

  <TextView
      android:id="@+id/tv_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/white"
      android:textSize="96sp"
      android:textStyle="bold"
      android:visibility="gone"
      android:shadowColor="#80000000"
      android:shadowDx="0"
      android:shadowDy="0"
      android:shadowRadius="16"
      app:layout_constraintTop_toTopOf="@id/layout_container"
      app:layout_constraintBottom_toBottomOf="@id/layout_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <LinearLayout
      android:id="@+id/layout_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:background="#1E1E1E"
      android:padding="8dp"
      android:gravity="center"
      app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

      <ImageView
          android:id="@+id/b_record"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:src="@drawable/record_icon" />

      <TextView
          android:id="@+id/tv_record_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Record"
          android:textColor="@color/white"
          android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

      <ImageView
          android:id="@+id/b_events"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:src="@drawable/sync_icon" />

      <TextView
          android:id="@+id/tv_events_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:maxLines="2"
          android:text="Connect to Events"
          android:textColor="@color/white"
          android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

      <ImageView
          android:id="@+id/b_start_stop"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:src="@drawable/stream_icon" />

      <TextView
          android:id="@+id/tv_stream_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Stream"
          android:textColor="@color/white"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
